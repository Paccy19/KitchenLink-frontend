# Dependencies (install with `npm ci`)
node_modules/

# Build output (`npm run build`)
dist/

# Local environment files: keep secrets and machine-specific settings out of Git.
# .env.example (template) and .env.demo (demo mode, no secrets) stay tracked.
.env
.env.local
.env.*.local
.env.production

# Logs and editor/OS clutter
*.log
npm-debug.log*
.DS_Store
Thumbs.db
.vscode/
.idea/
