# Online Food Kitchen — frontend environment
# Copy to `.env.local` (or `.env`) and adjust.

# Base URL of the backend API (all endpoints are resolved against this).
# Examples:
#   /api/v1                      → same-origin proxy configured by VITE_API_PROXY
#   http://localhost:8000/api/v1 → direct backend URL
VITE_API_BASE_URL=/api/v1
VITE_API_PROXY=http://localhost:4000

# Mock mode for the built-in offline demo:
#   true            → always use mocks (frontend-only development)
#   auto            → discovery calls may fall back to mocks
#   false (default) → use the backend and surface network errors
VITE_USE_MOCK=false

# Request timeout in milliseconds (default 8000)
VITE_API_TIMEOUT=8000
