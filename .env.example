# Online Food Kitchen — frontend environment
# Copy to `.env.local` (or `.env`) and adjust.

# Base URL of the backend API (all endpoints are resolved against this).
# Examples:
#   /api/v1                      → same-origin proxy configured by VITE_API_PROXY
#   http://localhost:8000/api/v1 → direct backend URL
VITE_API_BASE_URL=/api/v1
VITE_API_PROXY=http://localhost:4000

# Where uploaded photos are served from (the backend's PUBLIC_BASE_URL), for
# the Content Security Policy added to production builds. https addresses are
# always allowed; set this only if photos come from a plain http address.
# Defaults to VITE_API_PROXY.
VITE_UPLOADS_ORIGIN=

# Request timeout in milliseconds (default 8000)
VITE_API_TIMEOUT=8000

# CARTO basemap key for the "nearby kitchens on a map" page (/vendors/map),
# rendered with MapLibre GL. Optional: the map works without a key on CARTO's
# free tier; commercial use requires a CARTO plan, whose key goes here.
VITE_CARTO_API_KEY=
