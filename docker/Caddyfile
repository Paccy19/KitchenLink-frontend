# Static file server inside the frontend container (plain HTTP on :8080).
# HTTPS and the public domain are handled by the main Caddy reverse proxy
# (deploy/Caddyfile in the backend repo), which forwards igikoni.online here.
{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	root * /srv
	encode zstd gzip

	header {
		# The site must never be shown inside another site's frame (clickjacking).
		# The main Content Security Policy is a <meta> tag in index.html, which
		# can't carry frame-ancestors, so it is sent here as a header.
		Content-Security-Policy "frame-ancestors 'none'"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Location is used (nearby kitchens, drivers); nothing needs camera/mic.
		Permissions-Policy "geolocation=(self), camera=(), microphone=(), payment=(), usb=()"
		-Server
	}

	# Vite puts a content hash in every file name under /assets/, so these can
	# be cached for a year; everything else (index.html, theme-init.js, icons)
	# is revalidated so a new release shows up immediately.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@unhashed not path /assets/*
	header @unhashed Cache-Control "no-cache"

	# Single-page app: unknown paths (e.g. /vendors/map after a refresh) load
	# index.html and React Router shows the right page. Missing /assets/ files
	# still return 404 instead of HTML.
	@spa not path /assets/*
	try_files @spa {path} /index.html

	file_server
}
