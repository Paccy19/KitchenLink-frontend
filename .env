# KitchenLink website — local development settings (see .env.example).

# API calls go to /api/v1 on the dev server, which proxies them to the backend.
VITE_API_BASE_URL=/api/v1
# Backend address (must match PORT in KitchenLink-backend/.env).
VITE_API_PROXY=http://localhost:4000

# Where uploaded photos come from (backend PUBLIC_BASE_URL). Empty = VITE_API_PROXY.
VITE_UPLOADS_ORIGIN=

# true = run on built-in demo data with no backend (`npm run demo` does this).
VITE_DEMO_MODE=false

# Request timeout in milliseconds.
VITE_API_TIMEOUT=8000

# Optional CARTO basemap key for /vendors/map (works without one on the free tier).
VITE_CARTO_API_KEY=cb1_4hue_2_de9cbc729193bdf2645905e8
